<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Doping Hafıza</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/doping_hafiza.styles.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark border-bottom shadow-sm">
            <div class="container-fluid px-lg-4">
                <a class="navbar-brand fw-bold d-flex align-items-center" asp-controller="Broadcast" asp-action="Index">
                    <span class="badge bg-danger me-2 px-2 py-1"><i class="bi bi-broadcast"></i> LIVE</span>
                    <span>Doping Hafıza</span>
                    <span class="text-secondary ms-2 fw-normal fs-6 d-none d-sm-inline">| Operasyon Merkezi</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link active fw-medium" asp-controller="Broadcast" asp-action="Index">
                                <i class="bi bi-speedometer2 me-1"></i> Yayın Operasyon Paneli
                            </a>
                        </li>
                    </ul>
                    <div class="navbar-text text-light small d-none d-md-block">
                        <i class="bi bi-person-badge me-1"></i> Senior .NET Case Study &bull; Canlı Takvim Takibi
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-lg-4 px-3">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-white py-3 mt-auto">
        <div class="container-fluid px-lg-4 d-flex flex-wrap justify-content-between align-items-center small">
            <div>
                &copy; @DateTime.Now.Year - <strong>Doping Hafıza</strong> - Canlı Yayın Operasyon Modülü
            </div>
            <div class="text-secondary">
                Pragmatic Architecture &bull; ASP.NET Core (.NET 9) &bull; Reminder Invalidation Pattern
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
